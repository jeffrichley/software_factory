#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""The Factory hook: runs on every Claude Code event in every session, so it stays
stdlib-only and never blocks or fails the session (ADR 0001).

Exits at once unless this Machine tracks the repo; otherwise POSTs the event, unchanged,
stamped with Machine, repo and the session's cached ids, and caches the reply's ids.
With the server down it queues the event and exits; the next event delivers the queue first.
"""

import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "cli"))
from factory_cli.tracking import load_setup, main_worktree, marker_path, send, session_cache_path  # noqa: E402

# Events whose hookSpecificOutput.additionalContext Claude Code reads.
CONTEXT_EVENTS = {
    "SessionStart", "SubagentStart", "UserPromptSubmit", "UserPromptExpansion",
    "PreToolUse", "PostToolUse", "PostToolUseFailure", "Stop", "SubagentStop",
}
REPLY_IDS = ("session_id", "job_id", "step_id")


def mattpocock_skills_version() -> str | None:
    claude = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
    try:
        installed = json.loads((claude / "plugins" / "installed_plugins.json").read_text())
        return installed["plugins"]["mattpocock-skills@mattpocock"][0]["version"]
    except (OSError, ValueError, LookupError, TypeError):
        return None


def main() -> None:
    event = json.load(sys.stdin)
    setup = load_setup()
    main_tree = main_worktree(event.get("cwd") or os.getcwd())
    if not setup or not main_tree:
        return
    machine = setup["machine"]
    try:
        marker = json.loads(marker_path(main_tree, machine).read_text())
    except (OSError, ValueError):
        return

    cache = session_cache_path(main_tree, machine, event["session_id"])
    try:
        ids = json.loads(cache.read_text())
    except (OSError, ValueError):
        ids = {}
    body = {"machine": machine, "repo": marker["repo"], "repo_path": str(main_tree), "ids": ids, "event": event}
    if event.get("hook_event_name") == "SessionStart":
        body["mattpocock_skills_version"] = mattpocock_skills_version()

    try:
        # Queued events go first, in order; with the server down this one joins them.
        reply = send(main_tree, machine, setup["server_url"], body)
    except ValueError:
        return  # a reply that isn't JSON: nothing to cache
    if reply is None:
        return  # queued: never block the session

    cache.parent.mkdir(parents=True, exist_ok=True)
    cache.write_text(json.dumps({k: reply[k] for k in REPLY_IDS if k in reply}))
    name = event.get("hook_event_name")
    if reply.get("inject") and name in CONTEXT_EVENTS:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": name, "additionalContext": reply["inject"]}}))


if __name__ == "__main__":
    try:
        main()
    except Exception:  # noqa: BLE001 - a hook must never fail the session
        pass
