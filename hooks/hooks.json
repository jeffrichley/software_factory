{
  "description": "Reports every event in a Tracked repo to the Factory server. Never WorktreeCreate/WorktreeRemove: those would replace git's worktree handling.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--quiet",
              "--script",
              "${CLAUDE_PLUGIN_ROOT}/hooks/factory-hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--quiet",
              "--script",
              "${CLAUDE_PLUGIN_ROOT}/hooks/factory-hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
